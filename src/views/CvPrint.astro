---
// Designed CV, printed to PDF (scripts/make-cv-pdf.mjs). Same layout as Maël's own French CV
// (public/cv/CV-Mael-Compagnon-FR.pdf, made by him; decision of 17 Nov 2026): a navy band with
// the name, a round photo, a light blue column on the left, a timeline of dates on the right.
// The text is content/<lang>/09-cv.md, as for the ATS CV. One A4 page.
// The French CV people download is Maël's file: only the English one is printed from here.
import '@fontsource/poppins/latin-ext-400.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-ext-400-italic.css';
import '@fontsource/poppins/latin-400-italic.css';
import '@fontsource/poppins/latin-ext-500.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-ext-600.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-ext-700.css';
import '@fontsource/poppins/latin-700.css';
import type { Tokens } from 'marked';
import { Image } from 'astro:assets';
import photo from '../../assets/mael-junction.png';
import Print from '../layouts/Print.astro';
import { at, inline, splitDot, type Section } from '../lib/content';
import { cvData } from '../lib/cv';
import type { Lang } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const cv = cvData(lang);
// Sections, in order: profile, education, experience, volunteering, skills, interests.
const s = (i: number) => at(cv.sections, i, cv.doc.file);
const [profile, education, experience, volunteering, skills, interests] = [0, 1, 2, 3, 4, 5].map(s);

const listOfSection = (sec: Section) => (sec.tokens.find((x) => x.type === 'list') as Tokens.List | undefined)?.items.map((i) => i.text) ?? [];
const textOf = (sec: Section) => (sec.tokens.find((x) => x.type === 'paragraph') as Tokens.Paragraph | undefined)?.text ?? '';
const isDate = (x: string) => /\d{4}/.test(x) && !x.includes('(');
// "**Head** · place · date"
const BOLD = /^\*\*(.+?)\*\*\s*(?:·\s*)?(.*)$/;

interface Entry {
  org: string;
  place: string;
  date: string;
  role: string;
  text: string;
  bullets: string[];
}
const entry = (o: Partial<Entry>): Entry => ({ org: '', place: '', date: '', role: '', text: '', bullets: [], ...o });

// Education: "**Title** · school, town · dates".
const schools = listOfSection(education).map((item) => {
  const parts = splitDot(item);
  const date = parts.length > 1 && isDate(parts[parts.length - 1]) ? parts.pop()! : '';
  const head = (parts.shift() ?? '').replace(/^\*\*|\*\*$/g, '');
  return entry({ org: head, place: parts.join(' · '), date });
});

// Experience: a company line, an italic role line, then a list.
const jobs: Entry[] = [];
for (const tok of experience.tokens) {
  if (tok.type === 'paragraph') {
    const [first, ...more] = (tok as Tokens.Paragraph).text.split('\n');
    const m = first.match(BOLD);
    if (!m) continue;
    const [org, ...place] = splitDot(m[1]);
    jobs.push(entry({ org, place: place.join(' · '), date: m[2].trim(), role: more.join(' ').replace(/^\*|\*$/g, '') }));
  } else if (tok.type === 'list' && jobs.length) {
    jobs[jobs.length - 1].bullets = (tok as Tokens.List).items.map((i) => i.text);
  }
}

// Volunteering: "**Club** · role · dates: what I do".
const clubs = listOfSection(volunteering).map((item) => {
  const m = item.match(BOLD);
  if (!m) return entry({ text: item });
  const rest = m[2].match(/^(.*?)(?:\s·\s(\d{4}\s–\s[^:]+))?\s?:\s(.*)$/);
  return rest ? entry({ org: m[1], role: rest[1], date: rest[2] ?? '', text: rest[3] }) : entry({ org: m[1], text: m[2] });
});

// Skills: "**Label:** values"; the languages line goes to its own block on the left.
const skillItems = listOfSection(skills).map((item) => {
  const m = item.match(/^\*\*(.+?):?\*\*:?\s*(.*)$/);
  return { label: (m?.[1] ?? '').replace(/\s*:$/, ''), value: m?.[2] ?? item };
});
const langItem = skillItems.pop()!;
const languages = [...langItem.value.matchAll(/([^,(]+?)\s*\(([^)]*)\)/g)].map((m) => ({ name: m[1].trim(), level: m[2].trim() }));
const hobbies = splitDot(textOf(interests));

const contacts = [...cv.contacts, ...cv.links];
---

<Print lang={lang} title={`CV · ${cv.name}`} margin="0">
  <div class="cvd">
    <div class="cvd__col" aria-hidden="true"></div>
    <div class="cvd__band" aria-hidden="true"></div>
    <div class="cvd__photo">
      <Image src={photo} alt="" width={640} height={480} loading="eager" />
    </div>

    <header class="cvd__head">
      <h1 set:html={inline(cv.name)} />
      <p class="cvd__title" set:html={inline(cv.title)} />
      <p class="cvd__goal" set:html={inline(cv.goal)} />
    </header>

    <aside class="cvd__side">
      <p class="cvd__profile" set:html={inline(textOf(profile))} />

      <section>
        <h2>{t.cvContact}</h2>
        <ul class="cvd__bars">
          {
            contacts.map((c) =>
              c.kind === 'phone' ? <li data-cv-phone hidden /> : <li>{c.href ? <a href={c.href}>{c.text}</a> : <span set:html={c.html} />}</li>,
            )
          }
        </ul>
      </section>

      <section>
        <h2 set:html={inline(langItem.label)} />
        <ul class="cvd__bars cvd__langs">
          {
            languages.map((l) => (
              <li>
                <span>{l.name}</span>
                <span class="cvd__level">{l.level}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 set:html={inline(skills.title)} />
        <ul class="cvd__bars cvd__skills">
          {
            skillItems.map((k) => (
              <li>
                <strong set:html={inline(k.label + (lang === 'fr' ? ' :' : ':'))} /> <span set:html={inline(k.value)} />
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 set:html={inline(interests.title)} />
        <ul class="cvd__bars">{hobbies.map((h) => <li set:html={inline(h)} />)}</ul>
      </section>
    </aside>

    <main class="cvd__main">
      {
        [
          { sec: education, items: schools },
          { sec: experience, items: jobs },
          { sec: volunteering, items: clubs },
        ].map(({ sec, items }) => (
          <section>
            <h2 set:html={inline(sec.title)} />
            <ol class="cvd__line">
              {items.map((e) => (
                <li>
                  <div class="cvd__what">
                    <h3>
                      <span set:html={inline(e.org)} />
                      {e.place && (
                        <>
                          {' | '}
                          <span class="cvd__place" set:html={inline(e.place)} />
                        </>
                      )}
                    </h3>
                    {e.role && <p class="cvd__role" set:html={inline(e.role)} />}
                    {e.text && <p set:html={inline(e.text)} />}
                    {e.bullets.length > 0 && (
                      <ul>
                        {e.bullets.map((b) => (
                          <li set:html={inline(b)} />
                        ))}
                      </ul>
                    )}
                  </div>
                  <p class="cvd__when" set:html={inline(e.date)} />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </main>
  </div>
</Print>

<style is:global>
  /* Scoped to .cvd: this page shares nothing with the site's stylesheet. Solid fills only:
     pdf.js (the previews of the site) draws hard-stop gradients as black bars. */
  .cvd {
    --navy: #0f3a62;
    --navy-2: #1d4c79;
    --ink: #102a46;
    --blue: #2b5f91;
    --sky: #c4e0fb;
    --soft: #86b3dc;
    --line: #9cc3e8;
    position: relative;
    width: 210mm;
    height: 296.6mm;
    overflow: hidden;
    margin: 0 auto;
    background: #fff;
    font-family: Poppins, Arial, sans-serif;
    font-size: 7.9pt;
    line-height: 1.4;
    color: var(--navy-2);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .cvd :is(h1, h2, h3, p, ul, ol) {
    margin: 0;
  }

  /* The light blue column, rounded at the top like a tab. */
  .cvd__col {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 73mm;
    border-top-right-radius: 16mm;
    background: var(--sky);
  }

  .cvd__band {
    position: absolute;
    top: 12mm;
    left: 0;
    right: 3mm;
    height: 39mm;
    border-radius: 0 20mm 20mm 0;
    background: var(--navy);
  }

  .cvd__photo {
    position: absolute;
    top: 6mm;
    left: 12mm;
    width: 56mm;
    height: 51mm;
    overflow: hidden;
    border-radius: 46% 54% 42% 58% / 52% 44% 56% 48%;
    background: var(--sky);
  }

  .cvd__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .cvd__head {
    position: absolute;
    top: 16mm;
    left: 80mm;
    right: 14mm;
    color: #fff;
  }

  .cvd h1 {
    font-size: 25pt;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .cvd__title {
    margin-top: 1.5mm;
    font-size: 10.5pt;
    font-style: italic;
    line-height: 1.25;
  }

  .cvd__goal {
    margin-top: 2.5mm;
    font-size: 8.6pt;
    line-height: 1.3;
    color: #a9cdf0;
  }

  .cvd__side {
    position: absolute;
    top: 61mm;
    left: 8mm;
    width: 59mm;
    color: var(--navy-2);
  }

  .cvd__profile {
    text-align: justify;
    hyphens: auto;
  }

  .cvd__side section {
    margin-top: 4.6mm;
  }

  /* Left titles: underlined with a thick rounded bar. */
  .cvd__side h2 {
    display: inline-block;
    margin-bottom: 1.8mm;
    padding-bottom: 0.6mm;
    border-bottom: 1.1mm solid var(--blue);
    border-radius: 0 0 0.6mm 0.6mm;
    font-size: 10.4pt;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }

  /* Items after a small vertical bar. */
  .cvd__bars {
    padding: 0;
    list-style: none;
  }

  .cvd__bars li {
    position: relative;
    padding-left: 3mm;
  }

  .cvd__bars li + li {
    margin-top: 0.9mm;
  }

  .cvd__bars li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.8mm;
    height: 0.95em;
    margin-top: -0.25em;
    border-radius: 0.4mm;
    background: var(--navy);
  }

  .cvd__langs li {
    display: flex;
    justify-content: space-between;
    gap: 3mm;
  }

  .cvd__level {
    text-align: right;
  }

  .cvd__skills strong {
    font-weight: 600;
    color: var(--ink);
  }

  .cvd a {
    color: inherit;
    text-decoration: none;
  }

  .cvd__main {
    position: absolute;
    top: 56mm;
    left: 79mm;
    right: 6mm;
  }

  .cvd__main section + section {
    margin-top: 3.4mm;
  }

  .cvd__main h2 {
    margin-bottom: 1.4mm;
    font-size: 13pt;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Each entry: what on the left, when on the right, on a timeline. */
  .cvd__line {
    position: relative;
    padding: 0;
    list-style: none;
  }

  .cvd__line::before {
    content: '';
    position: absolute;
    top: 1.4mm;
    bottom: 1.4mm;
    left: calc(100% - 29mm);
    width: 0.5mm;
    background: var(--line);
  }

  .cvd__line > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 27mm;
    gap: 0 4.6mm;
    break-inside: avoid;
  }

  .cvd__line > li + li {
    margin-top: 1.8mm;
  }

  .cvd h3 {
    font-size: 9pt;
    font-weight: 600;
    line-height: 1.25;
    color: var(--blue);
  }

  .cvd__place {
    color: var(--soft);
  }

  .cvd__role {
    font-style: italic;
    text-decoration: underline;
    text-decoration-thickness: 0.15mm;
    text-underline-offset: 0.5mm;
  }

  .cvd__what ul {
    margin-top: 0.4mm;
    padding-left: 3.4mm;
    list-style: disc;
  }

  .cvd__what ul li::marker {
    color: var(--blue);
  }

  /* "computer classes for…" after "role · dates:" in the source: a capital to start the line. */
  .cvd__what > p:not(.cvd__role)::first-letter {
    text-transform: uppercase;
  }

  .cvd__what em {
    font-style: italic;
  }

  .cvd__what strong {
    font-weight: 600;
  }

  .cvd__when {
    position: relative;
    padding-top: 0.2mm;
    font-size: 7.4pt;
    font-style: italic;
    line-height: 1.25;
    color: var(--navy-2);
  }

  .cvd__when::before {
    content: '';
    position: absolute;
    left: -3.85mm;
    top: 1.2mm;
    width: 2.2mm;
    height: 2.2mm;
    border-radius: 50%;
    background: var(--line);
  }
</style>
